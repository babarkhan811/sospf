# Go build output
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace / module cache artifacts
go.work
go.work.sum
vendor/

# Coverage and profiling
*.cover
coverage.*
cpu.prof
mem.prof

# Fuzz corpora (keep seed corpus under testdata/, ignore generated)
**/testdata/fuzz/

# Emulator / demo runtime output
/run/
*.pcap
*.log

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets / local keys (Ed25519 signing keys, HMAC secrets, agent certs)
*.pem
*.key
/keys/
local.env

# Python SDK
__pycache__/
*.pyc
sdk/python/py-scenario.json
